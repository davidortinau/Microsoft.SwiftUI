<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <DefineConstants Condition="'$(Configuration)' == 'Debug' and '$(AilohaAgentXCFramework)' != ''">$(DefineConstants);AILOHA_DEBUG</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Microsoft.SwiftUI.Sample.Shared/Microsoft.SwiftUI.Sample.Shared.csproj" />
    <ProjectReference Include="../Microsoft.SwiftUI.Sample.AilohaDebugBinding/Microsoft.SwiftUI.Sample.AilohaDebugBinding.csproj"
                      Condition="'$(Configuration)' == 'Debug' and '$(AilohaAgentXCFramework)' != ''" />
    <LinkerArgument Include="-F" Condition="'$(Configuration)' == 'Debug' and '$(AilohaAgentXCFramework)' != ''" />
    <LinkerArgument Include="$(AilohaAgentXCFramework)/macos-arm64_x86_64"
                    Condition="'$(Configuration)' == 'Debug' and '$(AilohaAgentXCFramework)' != ''" />
  </ItemGroup>
</Project>
